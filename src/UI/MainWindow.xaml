<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MainWin" Title="FSL Master" Width="1360" Height="840" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#16181D"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#1E2128"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="#272B34"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E8EAED"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA0A6"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3B7DD8"/>
    <SolidColorBrush x:Key="LineBrush" Color="#3A3F4A"/>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource Panel2Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavBtn" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="12,8">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Panel2Brush}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SegBtn" TargetType="RadioButton" BasedOn="{StaticResource NavBtn}">
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="3" Padding="10,4">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Panel2Brush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="RowBackground" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource Panel2Brush}"/>
      <Setter Property="AlternationCount" Value="2"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="SelectionMode" Value="Extended"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="ClipboardCopyMode" Value="ExcludeHeader"/>
      <Setter Property="EnableRowVirtualization" Value="True"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource Panel2Brush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LevelRows" TargetType="DataGridRow">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Background" Value="#40C62828"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Warning"><Setter Property="Background" Value="#40E65100"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LogRows" TargetType="DataGridRow">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Level}" Value="ERROR"><Setter Property="Background" Value="#40C62828"/></DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="WARN"><Setter Property="Background" Value="#40E65100"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- header -->
    <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="FSL Master" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Local FSLogix diagnostics and monitoring for Azure Virtual Desktop" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Period:" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
          <ComboBox x:Name="CmbPeriod" Width="100" ToolTip="Period for events and error counts">
            <ComboBoxItem Content="1 hour" Tag="1"/>
            <ComboBoxItem Content="24 hours" Tag="24" IsSelected="True"/>
            <ComboBoxItem Content="7 days" Tag="168"/>
            <ComboBoxItem Content="30 days" Tag="720"/>
          </ComboBox>
          <TextBlock Text="Auto-refresh:" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
          <ComboBox x:Name="CmbAuto" Width="90" ToolTip="Automatic refresh (overlapping refreshes are prevented)">
            <ComboBoxItem Content="Off" Tag="0" IsSelected="True"/>
            <ComboBoxItem Content="30 sec" Tag="30"/>
            <ComboBoxItem Content="60 sec" Tag="60"/>
            <ComboBoxItem Content="5 min" Tag="300"/>
          </ComboBox>
          <Button x:Name="BtnRefresh" Content="&#x21BB; Refresh" ToolTip="Fetch all data again (read-only)"/>
          <Button x:Name="BtnTheme" Content="Theme" ToolTip="Switch between dark and light theme" Margin="0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- navigation -->
      <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="8,10">
        <StackPanel>
          <RadioButton x:Name="NavDashboard" Style="{StaticResource NavBtn}" GroupName="nav" Content="Dashboard" IsChecked="True"/>
          <RadioButton x:Name="NavConfig" Style="{StaticResource NavBtn}" GroupName="nav" Content="FSLogix configuration"/>
          <RadioButton x:Name="NavServices" Style="{StaticResource NavBtn}" GroupName="nav" Content="Services and components"/>
          <RadioButton x:Name="NavSessions" Style="{StaticResource NavBtn}" GroupName="nav" Content="Users and sessions"/>
          <RadioButton x:Name="NavContainers" Style="{StaticResource NavBtn}" GroupName="nav" Content="Containers and redirects"/>
          <RadioButton x:Name="NavEvents" Style="{StaticResource NavBtn}" GroupName="nav" Content="Events"/>
          <RadioButton x:Name="NavLogs" Style="{StaticResource NavBtn}" GroupName="nav" Content="FSLogix log files"/>
          <RadioButton x:Name="NavHealth" Style="{StaticResource NavBtn}" GroupName="nav" Content="Health check"/>
          <RadioButton x:Name="NavUpdates" Style="{StaticResource NavBtn}" GroupName="nav" Content="Windows updates"/>
          <RadioButton x:Name="NavMaintenance" Style="{StaticResource NavBtn}" GroupName="nav" Content="Host maintenance"/>
          <RadioButton x:Name="NavReport" Style="{StaticResource NavBtn}" GroupName="nav" Content="Reporting"/>
          <RadioButton x:Name="NavAbout" Style="{StaticResource NavBtn}" GroupName="nav" Content="About FSL Master"/>
        </StackPanel>
      </Border>

      <!-- pages -->
      <Grid Grid.Column="1" Margin="14,12,14,8">

        <!-- Dashboard -->
        <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border x:Name="BdrBanner" CornerRadius="4" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed" Background="#40E65100" BorderBrush="#E65100" BorderThickness="1">
              <TextBlock x:Name="TxtBanner" TextWrapping="Wrap" FontWeight="SemiBold"/>
            </Border>
            <WrapPanel x:Name="WpCards"/>
            <TextBlock Text="Attention points" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,6"/>
            <DataGrid x:Name="GridDashIssues" MaxHeight="320" MinHeight="60"/>
          </StackPanel>
        </ScrollViewer>

        <!-- Configuration -->
        <Grid x:Name="PageConfig" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtCfgSearch" Width="240"/>
            <CheckBox x:Name="ChkCfgOnlySet" Content="Configured only"/>
            <Button x:Name="BtnCfgJson" Content="Export JSON"/>
            <Button x:Name="BtnCfgCsv" Content="Export CSV"/>
            <Button x:Name="BtnCfgCopy" Content="Copy selection"/>
          </StackPanel>
          <DataGrid x:Name="GridConfig" Grid.Row="1"/>
          <TextBlock x:Name="TxtCfgNote" Grid.Row="2" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                     Text="Effective value: policy (HKLM\SOFTWARE\Policies\FSLogix) takes precedence over the local value (HKLM\SOFTWARE\FSLogix). 'Unknown' under Default means no reliable default value could be established."/>
        </Grid>

        <!-- Services -->
        <Grid x:Name="PageServices" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnSvcStart" Content="&#x25B6; Start service" ToolTip="Management action: starts the selected FSLogix service (asks for confirmation)"/>
            <Button x:Name="BtnSvcStop" Content="&#x25A0; Stop service" ToolTip="Management action: stops the selected FSLogix service (asks for confirmation)"/>
            <Button x:Name="BtnSvcRestart" Content="&#x21BB; Restart service" ToolTip="Management action: restarts the selected FSLogix service (asks for confirmation)"/>
            <Button x:Name="BtnSvcCopy" Content="Copy selection"/>
            <TextBlock Text="&#x26A0; Service actions are management actions: confirmation required and everything is logged. Only frxsvc and frxccds." VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0"/>
          </StackPanel>
          <DataGrid x:Name="GridServices" Grid.Row="1"/>
        </Grid>

        <!-- Sessions -->
        <Grid x:Name="PageSessions" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtSesSearch" Width="240"/>
            <Button x:Name="BtnSesCsv" Content="Export CSV"/>
            <Button x:Name="BtnSesCopy" Content="Copy selection"/>
            <TextBlock x:Name="TxtSesCount" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"/>
          </StackPanel>
          <DataGrid x:Name="GridSessions" Grid.Row="1"/>
        </Grid>

        <!-- Containers -->
        <Grid x:Name="PageContainers" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <RadioButton x:Name="RbCtMain" Style="{StaticResource SegBtn}" GroupName="ct" Content="Containers" IsChecked="True"/>
            <RadioButton x:Name="RbCtVol" Style="{StaticResource SegBtn}" GroupName="ct" Content="Mounted VHD(X) volumes"/>
            <RadioButton x:Name="RbCtSmb" Style="{StaticResource SegBtn}" GroupName="ct" Content="SMB connections"/>
            <RadioButton x:Name="RbCtProf" Style="{StaticResource SegBtn}" GroupName="ct" Content="Local profiles"/>
            <RadioButton x:Name="RbCtRaw" Style="{StaticResource SegBtn}" GroupName="ct" Content="frx output (raw)"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtCtSearch" Width="220"/>
            <Button x:Name="BtnCtCsv" Content="Export CSV"/>
            <Button x:Name="BtnCtJson" Content="Export JSON"/>
            <Button x:Name="BtnCtHtml" Content="Export HTML"/>
            <Button x:Name="BtnCtCopy" Content="Copy selection"/>
          </StackPanel>
          <Grid Grid.Row="2">
            <DataGrid x:Name="GridContainers"/>
            <DataGrid x:Name="GridVolumes" Visibility="Collapsed"/>
            <DataGrid x:Name="GridSmb" Visibility="Collapsed"/>
            <DataGrid x:Name="GridProfiles" Visibility="Collapsed"/>
            <TextBox x:Name="TxtFrxRaw" Visibility="Collapsed" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True"/>
          </Grid>
          <TextBlock x:Name="TxtCtNote" Grid.Row="3" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
        </Grid>

        <!-- Events -->
        <Grid x:Name="PageEvents" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="Log:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbEvLog" Width="230"/>
            <TextBlock Text="Event ID:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtEvId" Width="70" ToolTip="For example 26 or 25,26,57"/>
            <CheckBox x:Name="ChkEvError" Content="Errors" IsChecked="True"/>
            <CheckBox x:Name="ChkEvWarn" Content="Warnings" IsChecked="True"/>
            <CheckBox x:Name="ChkEvInfo" Content="Information" IsChecked="True"/>
            <CheckBox x:Name="ChkEvMarked" Content="Marked IDs only"/>
            <TextBlock Text="User/SID:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtEvUser" Width="140"/>
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtEvSearch" Width="200"/>
          </WrapPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="BtnEvDetail" Content="Details"/>
            <Button x:Name="BtnEvCopy" Content="Copy message"/>
            <Button x:Name="BtnEvCsv" Content="Export CSV"/>
            <Button x:Name="BtnEvMarks" Content="Marked IDs..." ToolTip="Edit the list of marked Event IDs (local JSON configuration file)"/>
            <TextBlock x:Name="TxtEvCount" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"/>
          </StackPanel>
          <DataGrid x:Name="GridEvents" Grid.Row="2" RowStyle="{StaticResource LevelRows}"/>
          <TextBlock x:Name="TxtEvNote" Grid.Row="3" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
        </Grid>

        <!-- Logs -->
        <Grid x:Name="PageLogs" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="170"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel Grid.Row="0" Margin="0,0,0,6">
            <Button x:Name="BtnLogRefresh" Content="&#x21BB; Refresh list"/>
            <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="DpLogDate" Width="120" Margin="0,0,6,0"/>
            <Button x:Name="BtnLogDateClear" Content="Clear"/>
            <TextBlock Text="Load last:" VerticalAlignment="Center" Margin="10,0,6,0"/>
            <ComboBox x:Name="CmbLogTail" Width="110">
              <ComboBoxItem Content="256 KB" Tag="262144"/>
              <ComboBoxItem Content="1 MB" Tag="1048576" IsSelected="True"/>
              <ComboBoxItem Content="5 MB" Tag="5242880"/>
              <ComboBoxItem Content="20 MB" Tag="20971520"/>
            </ComboBox>
            <Button x:Name="BtnLogLoad" Content="Open"/>
          </WrapPanel>
          <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtLogSearch" Width="180"/>
            <TextBlock Text="User/SID:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtLogUser" Width="150"/>
            <CheckBox x:Name="ChkLogErr" Content="ERROR" IsChecked="True"/>
            <CheckBox x:Name="ChkLogWarn" Content="WARN" IsChecked="True"/>
            <CheckBox x:Name="ChkLogInfo" Content="Other" IsChecked="True"/>
            <StackPanel x:Name="SpLogQuick" Orientation="Horizontal"/>
          </WrapPanel>
          <DataGrid x:Name="GridLogFiles" Grid.Row="2" Margin="0,0,0,6"/>
          <DataGrid x:Name="GridLogLines" Grid.Row="3" RowStyle="{StaticResource LogRows}" FontFamily="Consolas"/>
          <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="BtnLogCopy" Content="Copy selection"/>
            <Button x:Name="BtnLogExport" Content="Export fragment..."/>
            <TextBlock x:Name="TxtLogInfo" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"/>
          </StackPanel>
        </Grid>

        <!-- Health -->
        <Grid x:Name="PageHealth" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="TxtScore" FontSize="40" FontWeight="SemiBold" Text="-" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock Text="/ 100" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,18,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtScoreStatus" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtScoreDetail" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnHealthRun" Content="&#x21BB; Run health check" ToolTip="Read-only checks; no changes are made"/>
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="8,0,6,0"/>
            <ComboBox x:Name="CmbHealthFilter" Width="150">
              <ComboBoxItem Content="All" IsSelected="True" Tag=""/>
              <ComboBoxItem Content="Problems only" Tag="problems"/>
              <ComboBoxItem Content="Error" Tag="Error"/>
              <ComboBoxItem Content="Warning" Tag="Warning"/>
              <ComboBoxItem Content="Unknown" Tag="Unknown"/>
            </ComboBox>
            <Button x:Name="BtnHealthCsv" Content="Export CSV"/>
            <Button x:Name="BtnHealthCopy" Content="Copy selection"/>
          </StackPanel>
          <DataGrid x:Name="GridHealth" Grid.Row="2"/>
        </Grid>

        <!-- Windows updates -->
        <Grid x:Name="PageUpdates" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnUpdCheck" Content="&#x21BB; Check for updates" ToolTip="Searches the configured update source (WSUS/Windows Update). Read-only: nothing is downloaded or installed."/>
            <Button x:Name="BtnUpdCsv" Content="Export findings CSV"/>
            <TextBlock x:Name="TxtUpdInfo" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" TextWrapping="Wrap"/>
          </StackPanel>
          <WrapPanel x:Name="WpUpdCards" Grid.Row="1"/>
          <DataGrid x:Name="GridUpdFindings" Grid.Row="2" Height="190" Margin="0,0,0,8"/>
          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Text="Pending updates (not installed)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Grid.Column="2" Text="Recent update history" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DataGrid x:Name="GridUpdPending" Grid.Row="1" Grid.Column="0"/>
            <DataGrid x:Name="GridUpdHistory" Grid.Row="1" Grid.Column="2"/>
          </Grid>
        </Grid>

        <!-- Host maintenance -->
        <Grid x:Name="PageMaintenance" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="150"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="130"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"
                       Text="Low-impact maintenance for AVD session hosts. Tools run at reduced priority with a timeout and can be cancelled. Nothing runs automatically and the host is never rebooted. Tip: put the host in drain mode first."/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Presets:" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Button x:Name="BtnPresetDiag" Content="Diagnostics (read-only)" ToolTip="Read-only checks. Nothing is changed."/>
              <Button x:Name="BtnPresetRoutine" Content="Routine (safe cleanup)" ToolTip="Quick checks plus low-risk cleanup of old temp/log/dump files."/>
              <Button x:Name="BtnPresetFull" Content="Full (incl. repair)" ToolTip="Adds DISM RestoreHealth and SFC /scannow. Use in a maintenance window."/>
              <Button x:Name="BtnPresetNone" Content="Clear selection"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <CheckBox x:Name="ChkMaintDry" Content="Dry run (preview only: cleanup and repair tasks change nothing)" IsChecked="True"/>
            <CheckBox x:Name="ChkMaintStop" Content="Stop on first error" IsChecked="True"/>
          </StackPanel>
          <DataGrid x:Name="GridMaintTasks" Grid.Row="2" IsReadOnly="False"/>
          <StackPanel Grid.Row="3" Margin="0,8,0,6">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnMaintPreflight" Content="Preflight check"/>
              <Button x:Name="BtnMaintRun" Content="&#x25B6; Run selected tasks"/>
              <Button x:Name="BtnMaintCancel" Content="&#x25A0; Cancel" IsEnabled="False"/>
              <Button x:Name="BtnMaintExport" Content="Export results CSV"/>
              <ProgressBar x:Name="PbMaint" Width="200" Height="10" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="8,0,8,0"/>
              <TextBlock x:Name="TxtMaintStatus" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </StackPanel>
          <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="GridMaintResults" Grid.Column="0"/>
            <TextBox x:Name="TxtMaintOutput" Grid.Column="2" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True"/>
          </Grid>
          <StackPanel Grid.Row="5" Margin="0,8,0,0">
            <TextBlock Text="Previous runs (reports are stored in the FSL Master log folder)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DataGrid x:Name="GridMaintHistory" MaxHeight="110" MinHeight="50"/>
          </StackPanel>
        </Grid>

        <!-- Report -->
        <ScrollViewer x:Name="PageReport" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Reporting" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"
                       Text="The report contains host information, Windows/AVD, FSLogix version, services, effective configuration, sessions, containers, recent relevant events, health check results, the health score and recommendations. The report is created from the last refresh."/>
            <CheckBox x:Name="ChkSanitize" Content="Sanitized report (masks user names, SIDs, server names, domain names and UNC paths)" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnRepHtml" Content="Export HTML"/>
              <Button x:Name="BtnRepJson" Content="Export JSON"/>
              <Button x:Name="BtnRepCsv" Content="Export CSV (per section)"/>
              <Button x:Name="BtnRepTxt" Content="Export TXT"/>
            </StackPanel>
            <TextBlock x:Name="TxtRepResult" Margin="0,12,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>

        <!-- About -->
        <ScrollViewer x:Name="PageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock x:Name="TxtAboutName" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtAboutDesc" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>
            <TextBlock x:Name="TxtAboutInfo" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock><Hyperlink x:Name="LnkRepo" NavigateUri="https://github.com/WayToWild/fsl-master">https://github.com/WayToWild/fsl-master</Hyperlink></TextBlock>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0"
                       Text="FSL Master works locally only, sends no telemetry and by default performs read-only checks. Use in production at your own risk; see the disclaimer in README.md."/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- status bar -->
    <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,6">
      <DockPanel>
        <TextBlock x:Name="TxtAdmin" DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Center"/>
        <Button x:Name="BtnErrors" DockPanel.Dock="Right" Content="Data source errors (0)" Margin="14,0,0,0" Padding="8,2"/>
        <TextBlock x:Name="TxtLast" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
        <ProgressBar x:Name="PbRefresh" DockPanel.Dock="Left" Width="180" Height="10" Minimum="0" Maximum="100" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Text="Ready" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
